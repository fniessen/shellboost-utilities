##? Usage: remove-zone-identifier-files [options]
##?
##? Remove files ending with "Zone.Identifier" in a directory hierarchy
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# Define custom exit codes.
readonly EX_OK=0
readonly EX_USAGE=64
readonly EX_DATAERR=65
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=69
readonly EX_SOFTWARE=70
readonly EX_CANTCREAT=73
readonly EX_IOERR=74
readonly EX_NOPERM=77
readonly EX_CONFIG=78

# Check if required commands are available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "${0##*/}: command not found: docopts" >&2
    exit $EX_UNAVAILABLE
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
eval "$(docopts -h "$help" -V "$version" : "$@")" || exit $?

# Exit on command failures.
set -e

# Set directory path (where Zone.Identifier files will be removed).
directory_path="."

# Check if the directory exists.
if [[ ! -d "$directory_path" ]]; then
    printf "Error: Directory does not exist: %s\n" "$directory_path" >&2
    exit $EX_NOINPUT
fi

# Find and remove files ending with "Zone.Identifier".
find "$directory_path" -type f -name "*Zone.Identifier" -delete -printf '%P\n' 2>/dev/null

# Exit with a success code.
exit $EX_OK

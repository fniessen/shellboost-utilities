#!/usr/bin/env bash

#? find-large-directories, Time-stamp: <2026-08-10 Mon 11:46>
#? Copyright (C) 2023-2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later <http://gnu.org/licenses/gpl.html>.
#? This is free software: you are free to change and redistribute it.
#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: find-large-directories [options]
##?
##? Find large directories (≥ 50 MB).
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# Check if 'docopts' command is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "${0##*/}: command not found: docopts" >&2
    exit 2
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
eval "$(docopts -h "$help" -V "$version" : "$@")" || exit $?

# Exit on command failures.
set -e

# Minimum directory size in MB.
MIN_SIZE=50

# Level-1 directories only, filter >= MIN_SIZE MiB, sort descending.
du -m --max-depth=1 . 2>/dev/null \
    | awk -v min="${MIN_SIZE}" '
        {
            size = $1
            path = $2

            sub(/^\.\//, "", path)

            if (path == ".")
                next

            if (size >= min) {
                if (size >= 1024)
                    printf "%.1fGiB\t%s\n", size / 1024, path
                else
                    printf "%dMiB\t%s\n", size, path
            }
        }
    ' \
    | sort -rh -k1,1 \
    | while IFS=$'\t' read -r size path; do
          printf '%8s  %s\n' "$size" "$path"
      done

# Exit with a success code.
exit 0

#!/usr/bin/env bash

#? ff, Time-stamp: <2026-08-14 Fri 16:18>
#? Copyright (C) 2020-2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later <http://gnu.org/licenses/gpl.html>.
#? This is free software: you are free to change and redistribute it.
#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: ff [options] [PATTERN]
##?
##? Find files matching a string and print their full file name.
##?
##? NOTE:
##?   Permission denied errors are suppressed using '2> /dev/null'.
##?
##? Arguments:
##?   PATTERN                       optional string
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit
##?
##? Examples:
##?   ff                            list all files
##?   ff admin                      list files matching admin in their name

# {{{ Boilerplate

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# BSD sysexits(3) exit codes.
readonly EX_OK=0
readonly EX_USAGE=64
readonly EX_DATAERR=65
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=69
readonly EX_SOFTWARE=70
readonly EX_CANTCREAT=73
readonly EX_IOERR=74
readonly EX_NOPERM=77
readonly EX_CONFIG=78

# ANSI escape sequences (enabled only when output is a terminal).
if [[ -t 1 && "${NO_COLOR:-}" != "1" ]]; then
    readonly RESET=$'\e[0m'
    readonly BOLD=$'\e[1m'
    readonly GREEN=$'\e[32m'
    readonly RED=$'\e[31m'
    readonly YELLOW=$'\e[33m'
    readonly WHITE=$'\e[37m'
    readonly BGRED=$'\e[41m'
else
    readonly RESET=''
    readonly BOLD=''
    readonly GREEN=''
    readonly RED=''
    readonly YELLOW=''
    readonly WHITE=''
    readonly BGRED=''
fi

# Composite styles.
readonly ERROR="${BOLD}${WHITE}${BGRED}"
readonly WARNING="${BOLD}${YELLOW}"

# Check if required commands are available.
for cmd in docopts; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf '%s\n' "${0##*/}: command not found: $cmd" >&2
        exit $EX_UNAVAILABLE
    fi
done

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
docopts_output=$(docopts -h "$help" -V "$version" : "$@") || exit $?
eval "$docopts_output"

# Silence AI false positives: PATTERN is set dynamically by docopts.
PATTERN="${PATTERN:-}"

# Exit on command failures.
set -e

# }}}

# Color configuration. The 'ne' flag prevents grep from emitting erase-line ANSI
# sequences.
readonly DIR_COLOR="1;34"               # Blue directory names.
readonly HIGHLIGHT_COLOR="1;37;44"      # White on blue.

readonly GREP_COLOR_DIR="sl=${DIR_COLOR}:ms=0:mc=0:me=0:ne"
                                        # Blue directory, no match highlight.
readonly GREP_COLOR_RESET="sl=0:ms=0:mc=0:me=0:ne"
                                        # Reset all colors.
readonly GREP_COLOR_HIGHLIGHT="sl=${DIR_COLOR}:ms=${HIGHLIGHT_COLOR}:se=0:ne"
                                        # Blue directory, white-on-blue match.

# Escape the pattern for safe use in grep -P regex matching.
pattern_regex=$(printf '%s' "$PATTERN" | sed 's/[][\\.^$*+?{}|()]/\\&/g')

# Find and colorize matching filenames, hiding permission denied errors.
# NOTE: Use 'stdbuf -oL' to enforce line-buffered output through the pipeline.
# This ensures results stream live.
stdbuf -oL find . -type f -iname "*$PATTERN*" -printf '%P\n' 2> /dev/null \
    | GREP_COLORS="$GREP_COLOR_DIR" \
                 stdbuf -oL grep --color=always '[^/]*$' \
    | GREP_COLORS="$GREP_COLOR_RESET" \
                 stdbuf -oL grep --color=always -iP "$pattern_regex(?=[^/]*$)" \
    | GREP_COLORS="$GREP_COLOR_HIGHLIGHT" \
                 grep -Fi "$PATTERN" --color=always

#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: diff-directories [options] DIR1 DIR2
##?
##? Compare two directory trees recursively and display sorted differences.
##?
##? Arguments:
##?   DIR1                          First directory tree
##?   DIR2                          Second directory tree
##?
##? Options:
##?   -s, --report-identical-files  Report when two files are the same
##?   -h, --help                    Display this help and exit
##?   -V, --version                 Display version information and exit

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# Check if 'docopts' command is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "${0##*/}: command not found: docopts" >&2
    exit 2
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
eval "$(docopts -h "$help" -V "$version" : "$@")" || exit $?

# ANSI escape sequences (enabled only when output is a terminal).
if [[ -t 1 && "${NO_COLOR:-}" != "1" ]]; then
    readonly RESET=$'\e[0m'
    readonly RED=$'\e[31m'
    readonly GREEN=$'\e[32m'
    readonly BLUE=$'\e[34m'
else
    readonly RESET=''
    readonly RED=''
    readonly GREEN=''
    readonly BLUE=''
fi

# Exit on non-zero command status.
set -e

# Check if both directories exist.
if [[ ! -d "$DIR1" ]]; then
    printf "Error: Directory '%s' does not exist.\n" "$DIR1" >&2
    exit 2
fi

if [[ ! -d "$DIR2" ]]; then
    printf "Error: Directory '%s' does not exist.\n" "$DIR2" >&2
    exit 2
fi

# Re-enable fail-fast error handling.
set +e

if [[ $report_identical_files == true ]]; then
    diff_opts="-rqs"
else
    diff_opts="-rq"
fi

# Perform a recursive directory comparison, suppress errors, sort the output,
# and display it.
diff_output=$(diff $diff_opts "$DIR1" "$DIR2" 2>/dev/null)
if [[ -n "$diff_output" ]]; then
    printf '%s\n' "$diff_output" | sort | while IFS= read -r line; do
        case "$line" in
            "Only in $DIR1:"*)
                printf '%s%s%s\n' "$RED" "$line" "$RESET"
                ;;
            "Only in $DIR2:"*)
                printf '%s%s%s\n' "$GREEN" "$line" "$RESET"
                ;;
            *" differ")
                printf '%s%s%s\n' "$BLUE" "$line" "$RESET"
                ;;
            *)
                printf '%s\n' "$line"
                ;;
        esac
    done
else
    printf "No differences found between directories.\n"
fi

# Exit successfully.
exit 0

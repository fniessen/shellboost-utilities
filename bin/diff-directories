#!/usr/bin/env bash

#? diff-directories, Time-stamp: <2026-08-10 Mon 11:59>
#? Copyright (C) 2024-2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later

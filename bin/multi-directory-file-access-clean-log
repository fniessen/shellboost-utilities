#!/usr/bin/env bash

#? file-access-clean-log, Time-stamp: <2026-08-10 Mon 11:47>
#? Copyright (C) 2023-2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later <http://gnu.org/licenses/gpl.html>.

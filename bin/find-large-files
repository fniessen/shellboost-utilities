#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: find-large-files [options]
##?
##? Find large files (≥ 50 MB).
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# Check if 'docopts' command is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "${0##*/}: command not found: docopts" >&2
    exit 2
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
eval "$(docopts -h "$help" -V "$version" : "$@")" || exit $?

# Exit on command failures.
set -e

# Minimum file size in MB.
MIN_SIZE=50

# Find all files that are larger than the minimum size, sort by size in
# descending order.
find . -type f -size +"${MIN_SIZE}"M -readable -printf '%s\t%p\n' 2>/dev/null \
    | sort -nr -k1,1 \
    | while IFS=$'\t' read -r size file; do
          printf '%8s  %s\n' \
                 "$(numfmt --to=iec-i --suffix=B "$size")" \
                 "${file#./}"
      done

# Exit with a success code.
exit 0

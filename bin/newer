#!/usr/bin/env bash

# Usage: newer FILE REF
#
# Check if FILE is newer than REF.

# Check for required arguments.
if [[ $# -ne 2 ]]; then
    printf "Usage: %s FILE REF\n" "$(basename "$0")" >&2
    exit 2
fi

FILE="$1"
REF="$2"

# Check if both arguments are files and exist.
if [[ ! -e "$FILE" ]]; then
    printf "Error: File '%s' does not exist.\n" "$FILE" >&2
    exit 2
fi

if [[ ! -e "$REF" ]]; then
    printf "Error: Reference file '%s' does not exist.\n" "$REF" >&2
    exit 2
fi

# Compare file timestamps.
if [[ ! "$FILE" -nt "$REF" ]]; then
    printf "%s is older than or the same age as %s\n" "$FILE" "$REF" >&2
    exit 2
fi

# If the file is newer than the reference, print message.
printf "%s is newer than %s\n" "$FILE" "$REF"

# Exit with a success code.
exit 0

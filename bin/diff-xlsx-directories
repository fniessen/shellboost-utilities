#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: diff-xlsx-directories [options] DIR1 DIR2
##?
##? Compare Excel files found in two directory trees.
##?
##? Arguments:
##?   DIR1                          first directory tree
##?   DIR2                          second directory tree
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# Set -uo pipefail for undefined variable check and pipeline failure propagation.
set -uo pipefail

# Check if docopts is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "Error: 'docopts' command not found." >&2
    exit 2
fi

# Extract help and version information from the script.
help=$(grep '^##\?' "$0" | cut -c 5-)
version=$(grep '^#\?' "$0" | cut -c 4-)

# Parse command-line arguments.
eval "$(docopts -h "$help" -V "$version" : "$@")"

# Set -e to exit on non-zero command status.
set -e

if ! command -v xlsx2csv >/dev/null 2>&1; then
    printf 'Error: xlsx2csv is not installed or not in your PATH.\n' >&2
    printf 'Install it with: pip install --user xlsx2csv\n' >&2
    exit 1
fi

if [[ ! -d "$DIR1" ]]; then
    printf "Error: '%s' is not a directory.\n" "$DIR1" >&2
    exit 1
fi

if [[ ! -d "$DIR2" ]]; then
    printf "Error: '%s' is not a directory.\n" "$DIR2" >&2
    exit 1
fi

# Use colordiff for displayed differences when available.
if command -v colordiff >/dev/null 2>&1; then
    readonly DIFF_CMD=colordiff
else
    readonly DIFF_CMD=diff
fi

status=0

# Compare all XLS/XLSX files found in either directory.
while IFS= read -r file; do
    file1="$DIR1/$file"
    file2="$DIR2/$file"

    printf '=== %s ===\n' "$file"

    if [[ ! -f "$file1" ]]; then
        printf 'Only in %s\n' "$DIR2"
        printf '\n'
        status=1
        continue
    fi

    if [[ ! -f "$file2" ]]; then
        printf 'Only in %s\n' "$DIR1"
        printf '\n'
        status=1
        continue
    fi

    # Convert both Excel files to CSV for a reliable text-based comparison.
    csv1="${file1%.*}.csv"
    csv2="${file2%.*}.csv"

    xlsx2csv "$file1" >"$csv1"
    xlsx2csv "$file2" >"$csv2"

    # Remove generated CSV files if they are identical; otherwise, keep them
    # for inspection and display their differences.
    if diff -u "$csv1" "$csv2" >/dev/null; then
        printf 'Files are identical\n'
        rm -f "$csv1" "$csv2"
    else
        "$DIFF_CMD" -u "$csv1" "$csv2" || true
        status=1
    fi

    printf '\n'
done < <(
    find "$DIR1" "$DIR2" \
         -type f \( -iname '*.xlsx' -o -iname '*.xls' \) \
         -printf '%P\n' |
        sort -u
)

exit "$status"

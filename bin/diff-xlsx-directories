#!/usr/bin/env bash

#? diff-xlsx-directories, Time-stamp: <2026-07-28 Tue 16:52>
#? Copyright (C) 2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later
#? <https://gnu.org/licenses/gpl.html>.
#?
#? This is free software: you are free to change and redistribute it.
#? There is NO WARRANTY, to the extent permitted by law.

##? Usage: diff-xlsx-directories [options] DIR1 DIR2
##?
##? Compare Excel files found in two directory trees.
##?
##? Arguments:
##?   DIR1                          first directory tree
##?   DIR2                          second directory tree
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# Set -uo pipefail for undefined variable check and pipeline failure propagation.
set -uo pipefail

# Check if docopts is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "Error: 'docopts' command not found." >&2
    exit 2
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments.
eval "$(docopts -h "$help" -V "$version" : "$@")"

# Set -e to exit on non-zero command status.
set -e

if ! command -v xlsx2csv >/dev/null 2>&1; then
    printf 'Error: xlsx2csv is not installed or not in your PATH.\n' >&2
    printf 'Install it with: pip install --user xlsx2csv\n' >&2
    exit 1
fi

if [[ ! -d "$DIR1" ]]; then
    printf "Error: '%s' is not a directory.\n" "$DIR1" >&2
    exit 1
fi

if [[ ! -d "$DIR2" ]]; then
    printf "Error: '%s' is not a directory.\n" "$DIR2" >&2
    exit 1
fi

status=0

# Compare all XLS/XLSX files found in either directory.
while IFS= read -r file; do
    file1="$DIR1/$file"
    file2="$DIR2/$file"

    printf '=== %s ===\n' "$file"

    if [[ ! -f "$file1" ]]; then
        printf 'Only in %s\n' "$DIR2"
        printf '\n'
        status=1
        continue
    fi

    if [[ ! -f "$file2" ]]; then
        printf 'Only in %s\n' "$DIR1"
        printf '\n'
        status=1
        continue
    fi

    # Convert both Excel files to CSV for a reliable text-based comparison.
    csv1="${file1%.*}.csv"
    csv2="${file2%.*}.csv"

    # Always remove the generated CSV files when this iteration completes.
    cleanup_csv() {
        rm -f -- "$csv1" "$csv2"
    }

    xlsx2csv "$file1" >"$csv1"
    xlsx2csv "$file2" >"$csv2"

    # Avoid exiting immediately when git diff reports differences.
    set +e

    git diff --no-index \
        --color=always \
        --word-diff=color \
        --word-diff-regex='[^,]+' \
        --src-prefix="$DIR1/" \
        --dst-prefix="$DIR2/" \
        -- \
        <(sed 's/,/, /g; s/\r$//' "$csv1") \
        <(sed 's/,/, /g; s/\r$//' "$csv2") \
        | tail -n +4

    diff_status=$?

    set -e

    case "$diff_status" in
        0)
            printf 'Files are identical\n'
            ;;
        1)
            status=1
            ;;
        *)
            printf 'Error while comparing %s.\n' "$file" >&2
            cleanup_csv
            exit "$diff_status"
            ;;
    esac

    cleanup_csv
    printf '\n'
done < <(
    find "$DIR1" "$DIR2" \
        -type f \( -iname '*.xlsx' -o -iname '*.xls' \) \
        -printf '%P\n' |
        sort -u
)

exit "$status"

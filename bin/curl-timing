#!/usr/bin/env bash

# Mesure les temps d'une requête HTTP.
URL="${1:-https://example.com}"

curl -o /dev/null -s \
    -w "%{time_namelookup} %{time_connect} %{time_appconnect} %{time_total}\n" \
    "$URL" |
    awk '{
        printf "DNS:     %4.0f ms\n", $1*1000
        printf "Connect: %4.0f ms\n", $2*1000
        printf "TLS:     %4.0f ms\n", $3*1000
        printf "Total:   %4.0f ms\n", $4*1000
    }'

#!/usr/bin/env bash

# Find duplicate files, skipping empty ones and removing "./" prefix

set -euo pipefail

if command -v jdupes >/dev/null; then
    # jdupes is found, use it to find duplicate files
    printf "Using jdupes command to find duplicate files\n"
    jdupes -r -n -S -X nostr:/.git/ . | sed 's|^\./||'
else
    # jdupes is not found, use find command
    printf "jdupes command not found, using find command to find duplicate files\n"

    # find duplicate files and print their names
    find . -type d -name .git -prune -o -type f -not -empty -exec md5sum {} + \
        | sort \
        | awk '
            BEGIN {
              FS=" ";
            }
            {
              if (arr[$1] != "") {
                print arr[$1];
                print $2;
              }
              arr[$1]=$2;
            }
          ' \
        | sed 's|^\./||'
fi

# Exit with a success code.
exit 0

##? Usage: uncolor [options] [FILE]
##?
##? Strip color sequences from the input text.
##?
##? Arguments:
##?   FILE                          file
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit

# NOTE:
# This script removes ANSI color and control sequences from text streams.
# For more advanced handling (e.g. Unicode-aware processing or broader
# terminal escape-sequence support), consider using 'ansi2txt' or 'aha'.

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# BSD sysexits(3) exit codes.
readonly EX_OK=0
readonly EX_USAGE=64
readonly EX_DATAERR=65
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=69
readonly EX_SOFTWARE=70
readonly EX_CANTCREAT=73
readonly EX_IOERR=74
readonly EX_NOPERM=77
readonly EX_CONFIG=78

# Check if 'docopts' command is available.
if ! command -v docopts >/dev/null 2>&1; then
    printf '%s\n' "${0##*/}: command not found: docopts" >&2
    exit "$EX_UNAVAILABLE"
fi

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

case "${1:-}" in
    -h|--help)
        printf '%s\n' "$help"
        exit "$EX_OK"
        ;;
    -V|--version)
        printf '%s\n' "$version"
        exit "$EX_OK"
        ;;
esac

FILE="${1:-}"

# Exit on command failures.
set -e

readonly ANSI_ESCAPE_REGEX=$'s_\033\\[[0-9;?<>=]*[[:alpha:]]__g'

if [[ -n "$FILE" ]]; then
    if [[ ! -f "$FILE" || ! -r "$FILE" ]]; then
        printf '%s: cannot read file: %s\n' "${0##*/}" "$FILE" >&2
        exit "$EX_NOINPUT"
    fi
    sed -E "${ANSI_ESCAPE_REGEX}" "$FILE"
else
    sed -E "${ANSI_ESCAPE_REGEX}"
fi

exit "$EX_OK"

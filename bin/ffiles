##? Usage: ffiles [options] [PATTERN]
##?
##? Find files matching a string and print their full file name.
##?
##? NOTE:
##?   Permission denied errors are suppressed using '2>/dev/null'.
##?
##? Arguments:
##?   PATTERN                       optional string
##?
##? Options:
##?   -h, --help                    display this help and exit
##?   -V, --version                 display version information and exit
##?
##? Examples:
##?   ffiles                        list all files
##?   ffiles admin                  list files matching admin in their name

# {{{ Boilerplate

# Exit on undefined variables and pipeline errors.
set -uo pipefail

# BSD sysexits(3) exit codes.
readonly EX_OK=0
readonly EX_USAGE=64
readonly EX_DATAERR=65
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=69
readonly EX_SOFTWARE=70
readonly EX_CANTCREAT=73
readonly EX_IOERR=74
readonly EX_NOPERM=77
readonly EX_CONFIG=78

# ANSI escape sequences (enabled only when output is a terminal).
if [[ -t 1 && "${NO_COLOR:-}" != "1" ]]; then
    readonly RESET=$'\e[0m'
    readonly BOLD=$'\e[1m'
    readonly GREEN=$'\e[32m'
    readonly RED=$'\e[31m'
    readonly YELLOW=$'\e[33m'
    readonly WHITE=$'\e[37m'
    readonly BGRED=$'\e[41m'
else
    readonly RESET=''
    readonly BOLD=''
    readonly GREEN=''
    readonly RED=''
    readonly YELLOW=''
    readonly WHITE=''
    readonly BGRED=''
fi

# Composite styles.
readonly ERROR="${BOLD}${WHITE}${BGRED}"
readonly WARNING="${BOLD}${YELLOW}"

# Check if required commands are available.
for cmd in docopts; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf '%s\n' "${0##*/}: command not found: $cmd" >&2
        exit $EX_UNAVAILABLE
    fi
done

# Extract help and version information from the script.
help=$(grep '^##[?]' "$0" | cut -c 5-)
version=$(grep '^#[?]' "$0" | cut -c 4-)

# Parse command-line arguments using docopts.
docopts_output=$(docopts -h "$help" -V "$version" : "$@") || exit $?
eval "$docopts_output"

# Silence AI false positives: PATTERN is set dynamically by docopts.
PATTERN="${PATTERN:-}"

# Exit on command failures.
set -e

# }}}

if [[ -z $PATTERN ]]; then
    find . -type f -printf '%P\n' 2>/dev/null |
        perl -CS -pe '
            BEGIN {
                $dir_color = "\e[1;34m";
                $reset = "\e[0m";
            }

            s{^(.*/)?([^/\n]*)$}{
                ($1 ? $dir_color . $1 . $reset : "") . $2
            }e;
        '
else
    find . -type f -iname "*$PATTERN*" -printf '%P\n' 2>/dev/null |
        PATTERN="$PATTERN" perl -CS -pe '
            BEGIN {
                $pattern = quotemeta($ENV{PATTERN});
                $dir_color = "\e[1;34m";
                $highlight = "\e[1;37;44m";
                $reset = "\e[0m";
            }

            chomp;

            if (m{^(.*/)?([^/]*)$}) {
                $dir = $1 // "";
                $base = $2;

                $base =~ s/($pattern)/$highlight . $1 . $reset/ige;

                $_ = ($dir ? $dir_color . $dir . $reset : "") . $base . "\n";
            }
        '
fi

#!/usr/bin/env bash

#? replace-in-directory, Time-stamp: <2026-08-10 Mon 11:46>
#? Copyright (C) 2020-2026 Fabrice Niessen. All rights reserved.
#?
#? License GPLv3+: GNU GPL version 3 or later <http://gnu.org/licenses/gpl.html>.
